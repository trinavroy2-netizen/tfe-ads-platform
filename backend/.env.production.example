ENVIRONMENT=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=GENERATE_A_LONG_RANDOM_VALUE
ADMIN_EMAIL=you@yourcompany.com
ADMIN_PASSWORD=A_STRONG_UNIQUE_PASSWORD
# Your deployed dashboard URL(s) only - no localhost, no wildcards
CORS_ORIGINS=https://ads-dashboard.yourcompany.com
# Public HTTPS URL of this API (used in uploaded image URLs)
PUBLIC_BASE_URL=https://ads-api.yourcompany.com
UPLOAD_DIR=uploads
